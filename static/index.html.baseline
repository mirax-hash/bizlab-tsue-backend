<!DOCTYPE html>
<html lang="uz">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>BIZLAB TSUE PRO — Strategik Biznes Laboratoriyasi</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
  <style>
    .chat-scroll { max-height: 270px; overflow-y: auto; }
    @media print {
      body * { visibility: hidden; }
      #printable-executive-deck, #printable-executive-deck * { visibility: visible; }
      #printable-executive-deck { position: absolute; left: 0; top: 0; width: 100%; border: none !important; }
    }
  </style>
</head>
<body class="bg-slate-950 text-slate-100 min-h-screen flex flex-col font-sans">

  <!-- Header -->
  <header class="bg-slate-900 border-b border-slate-800 sticky top-0 z-50">
    <div class="max-w-7xl mx-auto px-4 py-3 flex justify-between items-center">
      <div class="flex items-center space-x-3">
        <div class="bg-gradient-to-r from-emerald-500 via-teal-500 to-indigo-600 text-white font-black px-3.5 py-1.5 rounded-xl text-lg tracking-wider shadow-lg">
          BIZLAB
        </div>
        <div>
          <h1 class="text-sm font-bold tracking-wide">BIZLAB TSUE PRO</h1>
          <p class="text-[11px] text-slate-400">TDIU Biznes Simulyatori, Keyslar Banki & Strategik Boshqaruv Kengashi</p>
        </div>
      </div>
      <!-- Asosiy Navigatsiya Menyusi -->
      <div class="flex items-center space-x-1 bg-slate-950 p-1.5 rounded-xl border border-slate-800 text-xs overflow-x-auto">
        <button onclick="switchView('cases')" id="tab-cases" class="px-3 py-1.5 rounded-lg font-black bg-amber-500 text-slate-950 shadow">
          <i class="fa-solid fa-briefcase mr-1"></i> 0. Case Study
        </button>
        <button onclick="switchView('battle')" id="tab-battle" class="px-3 py-1.5 rounded-lg font-bold text-slate-400 hover:text-white">1. Bozor Jangi</button>
        <button onclick="switchView('lab')" id="tab-lab" class="px-3 py-1.5 rounded-lg font-bold text-slate-400 hover:text-white">2. Milliy Keyslar</button>
        <button onclick="switchView('forensic')" id="tab-forensic" class="px-3 py-1.5 rounded-lg font-bold text-slate-400 hover:text-white">3. Balans Auditi</button>
        <button onclick="switchView('eoq')" id="tab-eoq" class="px-3 py-1.5 rounded-lg font-bold text-slate-400 hover:text-white">4. Ta'minot & EOQ</button>
        <button onclick="switchView('pricing')" id="tab-pricing" class="px-3 py-1.5 rounded-lg font-bold text-slate-400 hover:text-white">5. Dinamik Narx</button>
        <button onclick="switchView('security')" id="tab-security" class="px-3 py-1.5 rounded-lg font-bold text-slate-400 hover:text-white">6. Xavfsizlik</button>
        <button onclick="switchView('board')" id="tab-board" class="px-3 py-1.5 rounded-lg font-bold text-amber-400 hover:text-white border border-amber-500/30">
          <i class="fa-solid fa-chess-king mr-1"></i> Boshqaruv Kengashi
        </button>
        <a href="/scoreboard" target="_blank" class="px-2.5 py-1.5 rounded-lg text-amber-400 hover:bg-slate-900" title="Proyektor Katta Ekrani"><i class="fa-solid fa-tv"></i></a>
      </div>
    </div>
  </header>

  <main class="max-w-7xl mx-auto px-4 py-6 flex-1 w-full space-y-6">

    <!-- ================= 0-QISM: CASE STUDY (ODDIYDAN MURAKKABGACHA) ================= -->
    <section id="view-cases" class="space-y-6">
      <div class="bg-gradient-to-r from-slate-900 via-amber-950/40 to-slate-900 border border-amber-500/30 p-5 rounded-2xl flex flex-col md:flex-row justify-between items-center gap-4 shadow-2xl">
        <div>
          <span class="text-[10px] font-black uppercase tracking-wider px-2.5 py-0.5 rounded bg-amber-500 text-slate-950 font-bold">1-QISM: SITUATSION MASALALAR</span>
          <h2 class="text-xl font-black text-white mt-1">Amaliy Biznes va Boshqaruv Keyslari Banki</h2>
          <p class="text-xs text-slate-300">Boshlang'ichdan MBA darajasigacha: Formula va hisob-kitob orqali yechiladigan real amaliy vaziyatlar.</p>
        </div>
        <div class="flex gap-2">
          <button onclick="filterCaseList('all')" class="case-flt-btn px-3 py-1.5 rounded-xl text-xs font-bold bg-amber-500 text-slate-950" data-flt="all">Barchasi</button>
          <button onclick="filterCaseList('easy')" class="case-flt-btn px-3 py-1.5 rounded-xl text-xs font-semibold bg-slate-900 text-slate-300 border border-slate-800 hover:text-white" data-flt="easy">Boshlang'ich</button>
          <button onclick="filterCaseList('medium')" class="case-flt-btn px-3 py-1.5 rounded-xl text-xs font-semibold bg-slate-900 text-slate-300 border border-slate-800 hover:text-white" data-flt="medium">O'rta</button>
          <button onclick="filterCaseList('hard')" class="case-flt-btn px-3 py-1.5 rounded-xl text-xs font-semibold bg-slate-900 text-slate-300 border border-slate-800 hover:text-white" data-flt="hard">Murakkab (MBA)</button>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5" id="cases-grid-container">
        <!-- Dinamik keyslar -->
      </div>
    </section>

    <!-- 1-MODUL: BOZOR JANGI (ARENA) -->
    <section id="view-battle" class="space-y-6 hidden">
      <div class="bg-gradient-to-r from-slate-900 via-rose-950/40 to-slate-900 border border-rose-500/30 p-5 rounded-2xl flex flex-col md:flex-row justify-between items-center gap-4 shadow-2xl">
        <div>
          <div class="flex items-center gap-2">
            <span class="text-[10px] font-black uppercase tracking-wider px-2.5 py-0.5 rounded bg-rose-600 text-white">DUEL LIVE</span>
            <button onclick="openResourceModal('battle', 'video')" class="text-[11px] font-bold text-amber-400 hover:text-amber-300 bg-slate-950 px-2.5 py-0.5 rounded-full border border-amber-500/40">
              <i class="fa-solid fa-circle-play mr-1"></i> Video Dars
            </button>
            <button onclick="openResourceModal('battle', 'guide')" class="text-[11px] font-bold text-emerald-400 hover:text-emerald-300 bg-slate-950 px-2.5 py-0.5 rounded-full border border-emerald-500/40">
              <i class="fa-solid fa-file-pdf mr-1"></i> Metodik Qo'llanma
            </button>
          </div>
          <h2 class="text-xl font-black text-white mt-1">Uzum Express VS Yandex/Express24: Narx & Bozor Jangi</h2>
          <p class="text-xs text-slate-300">Deterministik Kurno/Bertran raqobat modeli asosida jamoalararo duel.</p>
        </div>
        <div class="text-right">
          <div class="text-[11px] text-slate-400 font-semibold uppercase">Turnir Raundi:</div>
          <div class="text-lg font-black text-amber-400" id="battle-round-lbl">1-Chorak (Raund 1/4)</div>
        </div>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
        <div class="bg-slate-900 border-2 border-emerald-500/50 p-5 rounded-2xl space-y-4 shadow-xl">
          <div class="flex justify-between items-center border-b border-slate-800 pb-2">
            <h3 class="text-xs font-bold text-emerald-400 uppercase flex items-center">
              <span class="w-2.5 h-2.5 rounded-full bg-emerald-400 mr-2 animate-pulse"></span> 1-Jamoa: Uzum Express
            </h3>
            <span class="text-xs text-slate-400">Kassa: <strong id="treasury-a" class="text-emerald-400">250,000,000 so'm</strong></span>
          </div>
          <div class="text-xs space-y-3">
            <div>Yetkazish narxi: <span id="v_a_p" class="font-bold text-emerald-400">14,000 so'm</span><input type="range" id="c_a_p" min="8000" max="22000" step="1000" value="14000" oninput="document.getElementById('v_a_p').innerText=parseInt(this.value).toLocaleString()+' so\'m'" class="w-full accent-emerald-500 cursor-pointer"></div>
            <div>Marketing byudjeti: <span id="v_a_m" class="font-bold text-emerald-400">20,000,000 so'm</span><input type="range" id="c_a_m" min="5000000" max="45000000" step="2500000" value="20000000" oninput="document.getElementById('v_a_m').innerText=parseInt(this.value).toLocaleString()+' so\'m'" class="w-full accent-emerald-500 cursor-pointer"></div>
            <div>Xizmat sifati investitsiyasi: <span id="v_a_q" class="font-bold text-emerald-400">12,000,000 so'm</span><input type="range" id="c_a_q" min="4000000" max="25000000" step="1000000" value="12000000" oninput="document.getElementById('v_a_q').innerText=parseInt(this.value).toLocaleString()+' so\'m'" class="w-full accent-emerald-500 cursor-pointer"></div>
          </div>
        </div>

        <div class="bg-slate-900 border-2 border-rose-500/50 p-5 rounded-2xl space-y-4 shadow-xl">
          <div class="flex justify-between items-center border-b border-slate-800 pb-2">
            <h3 class="text-xs font-bold text-rose-400 uppercase flex items-center">
              <span class="w-2.5 h-2.5 rounded-full bg-rose-400 mr-2 animate-pulse"></span> 2-Jamoa: Yandex / Express24
            </h3>
            <span class="text-xs text-slate-400">Kassa: <strong id="treasury-b" class="text-rose-400">250,000,000 so'm</strong></span>
          </div>
          <div class="text-xs space-y-3">
            <div>Yetkazish narxi: <span id="v_b_p" class="font-bold text-rose-400">15,000 so'm</span><input type="range" id="c_b_p" min="8000" max="22000" step="1000" value="15000" oninput="document.getElementById('v_b_p').innerText=parseInt(this.value).toLocaleString()+' so\'m'" class="w-full accent-rose-500 cursor-pointer"></div>
            <div>Marketing byudjeti: <span id="v_b_m" class="font-bold text-rose-400">18,000,000 so'm</span><input type="range" id="c_b_m" min="5000000" max="45000000" step="2500000" value="18000000" oninput="document.getElementById('v_b_m').innerText=parseInt(this.value).toLocaleString()+' so\'m'" class="w-full accent-rose-500 cursor-pointer"></div>
            <div>Xizmat sifati investitsiyasi: <span id="v_b_q" class="font-bold text-rose-400">10,000,000 so'm</span><input type="range" id="c_b_q" min="4000000" max="25000000" step="1000000" value="10000000" oninput="document.getElementById('v_b_q').innerText=parseInt(this.value).toLocaleString()+' so\'m'" class="w-full accent-rose-500 cursor-pointer"></div>
          </div>
        </div>
      </div>

      <div class="text-center">
        <button id="btn-run-duel" onclick="runDuelAction()" class="px-8 py-3.5 bg-gradient-to-r from-amber-500 via-rose-600 to-indigo-600 hover:opacity-95 text-white font-black rounded-xl text-xs shadow-2xl transition transform hover:scale-[1.01]">
          <i class="fa-solid fa-bolt-lightning mr-2"></i> RAUND TO'QNASHUVINI HISOBLASH (JANG!)
        </button>
      </div>

      <div class="bg-slate-900 border border-slate-800 p-5 rounded-2xl space-y-4">
        <div class="flex justify-between items-center border-b border-slate-800 pb-2">
          <h4 class="text-xs font-bold text-slate-300 uppercase">To'qnashuv Natijasi</h4>
          <span id="duel-winner-badge" class="text-xs font-bold px-3 py-1 rounded-full bg-slate-800 text-slate-400">Jang boshlanmadi</span>
        </div>
        <div id="duel-analysis-text" class="p-3 bg-slate-950 border border-slate-800 rounded-xl text-xs text-slate-300">
          Ikkala jamoa parametrlarni tanlab, tugmani bosing.
        </div>
        <div class="grid grid-cols-2 gap-4 text-xs">
          <div class="bg-emerald-950/20 border border-emerald-500/30 p-3 rounded-xl space-y-1">
            <div class="font-extrabold text-emerald-400 flex justify-between"><span>Uzum Express</span><span id="res-a-share">50%</span></div>
            <div>Buyurtmalar: <strong id="res-a-orders" class="text-white">12,500 ta</strong></div>
            <div>Sof Foyda: <strong id="res-a-profit" class="text-emerald-400">+25.0 mln</strong></div>
          </div>
          <div class="bg-rose-950/20 border border-rose-500/30 p-3 rounded-xl space-y-1">
            <div class="font-extrabold text-rose-400 flex justify-between"><span>Yandex / Express24</span><span id="res-b-share">50%</span></div>
            <div>Buyurtmalar: <strong id="res-b-orders" class="text-white">12,500 ta</strong></div>
            <div>Sof Foyda: <strong id="res-b-profit" class="text-rose-400">+25.0 mln</strong></div>
          </div>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 pt-2">
          <div class="h-40 flex flex-col items-center">
            <span class="text-[10px] text-slate-400 mb-1">Bozor Ulushi (%)</span>
            <canvas id="duelPieChart"></canvas>
          </div>
          <div class="h-40 flex flex-col items-center">
            <span class="text-[10px] text-slate-400 mb-1">Sof Foyda (so'm)</span>
            <canvas id="duelBarChart"></canvas>
          </div>
        </div>
      </div>
    </section>

    <!-- 2-MODUL: MILLIY KEYSLAR -->
    <section id="view-lab" class="grid grid-cols-1 lg:grid-cols-12 gap-6 hidden">
      <aside class="lg:col-span-4 space-y-4">
        <div class="bg-slate-900 border border-slate-800 rounded-2xl p-4 shadow-xl">
          <div class="flex justify-between items-center mb-3">
            <h3 class="text-xs font-bold text-slate-400 uppercase flex items-center">
              <i class="fa-solid fa-layer-group text-emerald-400 mr-2"></i> Milliy Keyslar Banki
            </h3>
            <button onclick="openResourceModal('lab', 'guide')" class="text-[10px] text-emerald-400 font-bold border border-emerald-500/40 px-2 py-0.5 rounded-full">
              Qo'llanma
            </button>
          </div>
          <div id="missions-list" class="space-y-2 max-h-[48vh] overflow-y-auto pr-1"></div>
        </div>
        <div class="bg-slate-900 border border-slate-800 rounded-2xl p-4 space-y-2 shadow-xl">
          <h4 class="text-xs font-bold text-amber-400 uppercase flex items-center">
            <i class="fa-solid fa-bolt mr-2 animate-bounce"></i> Bozor Zarbalari (Fors-major)
          </h4>
          <div id="shocks-container" class="space-y-2"></div>
        </div>
      </aside>

      <section class="lg:col-span-8 bg-slate-900 border border-slate-800 rounded-2xl p-6 space-y-5 shadow-xl">
        <div class="border-b border-slate-800 pb-3 flex justify-between items-start">
          <div>
            <span id="active-badge" class="text-[10px] font-bold uppercase tracking-wider px-2 py-0.5 rounded bg-emerald-950 text-emerald-400 border border-emerald-800">Kategoriya</span>
            <h2 id="active-title" class="text-lg font-black text-white mt-1">Keys Nomi</h2>
            <p id="active-desc" class="text-xs text-slate-400 mt-1">Tavsif...</p>
          </div>
          <button onclick="openResourceModal('lab', 'video')" class="text-xs text-amber-400 font-bold border border-amber-500/40 px-2.5 py-1 rounded-xl bg-slate-950">
            <i class="fa-solid fa-play mr-1"></i> Video
          </button>
        </div>

        <div class="grid grid-cols-4 gap-2 text-center text-xs font-semibold">
          <button onclick="gotoLabStep(1)" id="lab-step-btn-1" class="py-2.5 rounded-xl border border-emerald-500 bg-emerald-500/10 text-emerald-400 flex flex-col items-center">
            <i class="fa-solid fa-circle-play text-base"></i><span class="text-[11px] mt-1">1. Dars & Video</span>
          </button>
          <button onclick="gotoLabStep(2)" id="lab-step-btn-2" class="py-2.5 rounded-xl border border-slate-800 bg-slate-950 text-slate-400 flex flex-col items-center">
            <i class="fa-solid fa-clipboard-check text-base"></i><span class="text-[11px] mt-1">2. Test</span>
          </button>
          <button onclick="gotoLabStep(3)" id="lab-step-btn-3" class="py-2.5 rounded-xl border border-slate-800 bg-slate-950 text-slate-400 flex flex-col items-center">
            <i class="fa-solid fa-sliders text-base"></i><span class="text-[11px] mt-1">3. Simulyatsiya</span>
          </button>
          <button onclick="gotoLabStep(4)" id="lab-step-btn-4" class="py-2.5 rounded-xl border border-slate-800 bg-slate-950 text-slate-400 flex flex-col items-center">
            <i class="fa-solid fa-comments text-base"></i><span class="text-[11px] mt-1">4. SI Himoyasi</span>
          </button>
        </div>

        <!-- 1-BOSQICH -->
        <div id="lab-step-1" class="space-y-4">
          <div class="relative w-full aspect-video rounded-xl overflow-hidden border border-slate-800 bg-black">
            <iframe id="video-frame" class="w-full h-full" src="" title="Video lecture" frameborder="0" allowfullscreen></iframe>
          </div>
          <div class="p-3 bg-slate-950 border border-slate-800 rounded-xl text-xs text-slate-300">
            <h4 class="font-bold text-white mb-1"><i class="fa-solid fa-graduation-cap text-emerald-400 mr-1.5"></i> Keys vazifasi:</h4>
            <p id="theory-text">Yuklanmoqda...</p>
          </div>
          <button onclick="gotoLabStep(2)" class="w-full py-3 bg-emerald-600 hover:bg-emerald-500 text-white font-bold rounded-xl text-xs transition">
            Mavzuni o'rgandim, Testga o'tish →
          </button>
        </div>

        <!-- 2-BOSQICH -->
        <div id="lab-step-2" class="space-y-4 hidden">
          <h3 class="text-sm font-bold text-white border-b border-slate-800 pb-2">Situatsion Test Sinovi</h3>
          <div id="quiz-container" class="space-y-3"></div>
          <button onclick="submitQuizAction()" class="w-full py-2.5 bg-indigo-600 hover:bg-indigo-500 text-white font-bold rounded-xl text-xs transition">
            Testni tekshirish
          </button>
          <div id="quiz-result-box" class="p-3 rounded-xl text-xs hidden"></div>
        </div>

        <!-- 3-BOSQICH -->
        <div id="lab-step-3" class="space-y-5 hidden">
          <div class="border-b border-slate-800 pb-2 flex justify-between items-center">
            <h3 class="text-sm font-bold text-white">Sohaviy Boshqaruv Simulyatori</h3>
            <div id="lab-shock-alert" class="hidden text-xs bg-red-950 border border-red-500 text-red-300 px-3 py-1 rounded-lg font-bold">
              Fors-major faol!
            </div>
          </div>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-xs">
            <div id="lab-dynamic-controls" class="bg-slate-950 p-4 rounded-xl border border-slate-800 space-y-4"></div>
            <div class="bg-slate-950 p-4 rounded-xl border border-slate-800 flex flex-col justify-between space-y-3">
              <div id="lab-dynamic-kpis" class="grid grid-cols-3 gap-2 text-center border-b border-slate-800 pb-2"></div>
              <div class="h-28 flex justify-center"><canvas id="classicBarChart"></canvas></div>
              <div class="h-24 flex justify-center"><canvas id="classicPieChart"></canvas></div>
            </div>
          </div>
          <button onclick="gotoLabStep(4)" class="w-full py-2.5 bg-emerald-600 hover:bg-emerald-500 text-white font-bold rounded-xl text-xs transition shadow-lg">
            Qarorni qabul qildim, SI bilan bahsga o'tish →
          </button>
        </div>

        <!-- 4-BOSQICH: SI HIMOYASI -->
        <div id="lab-step-4" class="space-y-4 hidden">
          <div class="border-b border-slate-800 pb-2 flex justify-between items-center">
            <h3 class="text-sm font-bold text-white flex items-center">
              <i class="fa-solid fa-graduation-cap text-purple-400 mr-2"></i> SI Kafedra Professori bilan Ilmiy Himoya (3 Raund)
            </h3>
            <span class="text-xs bg-purple-950 border border-purple-700 text-purple-300 px-2.5 py-0.5 rounded-full font-bold">
              Bosqich: <span id="round-idx-lbl">1 / 3</span>
            </span>
          </div>
          <div id="chat-box" class="chat-scroll space-y-3 bg-slate-950 p-4 rounded-xl border border-slate-800 text-xs">
            <div class="flex items-start space-x-2">
              <div class="bg-purple-900/60 p-1.5 rounded-lg text-purple-300"><i class="fa-solid fa-user-tie"></i></div>
              <div class="bg-slate-900 border border-slate-800 p-2.5 rounded-xl text-slate-200 max-w-[85%] shadow">
                <strong>SI Professor:</strong> Assalomu alaykum! Simulyatsiya natijalaringizni ko'rib chiqdim. Nima sababdan aynan ushbu iqtisodiy parametrlarni tanladingiz? Bu tannarx va rentabellikka qanday ta'sir qildi?
              </div>
            </div>
          </div>
          <div class="flex space-x-2">
            <input type="text" id="chat-input" onkeydown="if(event.key==='Enter') sendChatMsg()" class="flex-1 p-2.5 bg-slate-950 border border-slate-800 rounded-xl text-xs text-white focus:outline-none focus:border-purple-500" placeholder="Iqtisodiy dalilingizni yozing (masalan: tannarx, rentabellik, kassa uzilishi)...">
            <button onclick="sendChatMsg()" id="chat-send-btn" class="px-5 bg-purple-600 hover:bg-purple-500 text-white font-bold rounded-xl text-xs transition flex items-center">
              <i class="fa-solid fa-paper-plane mr-1.5"></i> Yuborish
            </button>
          </div>

          <!-- Diplom Sertifikat -->
          <div id="certificate-card" class="mt-4 hidden">
            <div id="printable-certificate" class="p-6 bg-gradient-to-br from-slate-900 via-emerald-950/80 to-slate-900 border-2 border-emerald-500/80 rounded-2xl shadow-2xl text-center space-y-4">
              <div class="flex justify-between items-center border-b border-emerald-800/60 pb-3">
                <div class="text-left">
                  <div class="text-xs font-black tracking-widest text-emerald-400">TOSHKENT DAVLAT IQTISODIYOT UNIVERSITETI</div>
                  <div class="text-[10px] text-slate-400">"Biznes boshqaruvi va logistika" kafedrasi</div>
                </div>
                <div class="bg-emerald-500/20 text-emerald-400 px-3 py-1 rounded text-xs font-bold border border-emerald-500/30">BIZLAB VERIFIED</div>
              </div>
              <h3 class="text-lg font-black text-white mt-1">STRATEGIK BIZNES QARORLAR HIMOYASI</h3>
              <p class="text-xs text-slate-300 max-w-lg mx-auto">
                Ushbu sertifikat egasi virtual laboratoriyada <span class="text-emerald-400 font-bold" id="cert-mission-name">Keys</span> bo'yicha simulyatsiya va SI himoyasini muvaffaqiyatli yakunlaganini tasdiqlaydi.
              </p>
              <div class="grid grid-cols-3 gap-2 bg-slate-950/80 p-3 rounded-xl border border-slate-800 text-xs">
                <div><div class="text-[10px] text-slate-500">Talaba</div><div class="font-bold text-white">Mirzarakhim B.</div></div>
