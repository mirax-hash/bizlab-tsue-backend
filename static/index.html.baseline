      <div class="space-y-3 text-xs">
        <div class="p-3.5 bg-slate-950 rounded-2xl border border-slate-800">
          <strong class="text-amber-400 block mb-1 text-[11px] uppercase">Vaziyat (Situation):</strong>
          <p id="cs-modal-sit" class="text-slate-300 leading-relaxed"></p>
        </div>
        <div class="p-3.5 bg-slate-950 rounded-2xl border border-slate-800 space-y-2">
          <strong class="text-emerald-400 block text-[11px] uppercase">Amaliy Masala & Hisob-kitob:</strong>
          <p id="cs-modal-prompt" class="text-slate-300"></p>
          <div id="cs-modal-inputs" class="space-y-2"></div>
          <button onclick="checkCaseSolution()" class="w-full py-2.5 rounded-xl bg-emerald-500 hover:bg-emerald-400 text-slate-950 font-bold transition">
            Tekshirish va Baholash
          </button>
        </div>
        <div id="cs-modal-res" class="p-3 rounded-2xl bg-slate-950 border border-slate-800 hidden space-y-1">
          <div class="flex justify-between font-bold">
            <span class="text-slate-400">Natija:</span>
            <span id="cs-modal-score" class="font-mono"></span>
          </div>
          <p id="cs-modal-feedback" class="text-slate-300 text-[11px]"></p>
        </div>
      </div>
      <div class="flex justify-end pt-2 border-t border-slate-800">
        <button onclick="closeCaseSolveModal()" class="px-5 py-2 rounded-xl bg-slate-800 text-white text-xs font-bold hover:bg-slate-700">Yopish</button>
      </div>
    </div>
  </div>

  <script>
    let duelRound = 1;
    let treasuryA = 250000000;
    let treasuryB = 250000000;
    let duelPieInst = null;
    let duelBarInst = null;
    let eoqChartInst = null;
    let boardChartInst = null;

    let missions = [];
    let activeMission = null;
    let activeShock = null;
    let classicBarInst = null;
    let classicPieInst = null;
    let chatHistory = [];
    let labRound = 1;

    window.lastMetrics = {
      battle_profit: 25000000.0,
      forensic_cash_flow: 15000000.0,
      eoq_annual_cost: 12000000.0,
      pricing_profit_delta: 8000000.0,
      survival_score: 78
    };

    // 0-QISM: KEYS MAJBUI
    const caseBank = [
      {
        id: 1, level: 'easy', levelTxt: "Boshlang'ich (Oddiy)", title: "Qahvaxona Rentabelligi va Marja",
        sit: "Kichik qahvaxona ochmoqchisiz. 1 chashka qahva narxi 18,000 so'm, xomashyo 7,000 so'm.",
        prompt: "Kuniga 120 ta qahva sotilsa, 1 oylik (30 kunlik) yalpi daromad (Gross Profit) qancha so'm bo'ladi?",
        inputs: [{ id: 'c_gp', label: "Yalpi daromad (so'm):", val: 39600000, hint: "(18,000 - 7,000) * 120 * 30" }],
        success: "To'g'ri! Yalpi daromad 39,600,000 so'm. Har bir qahvadan 11,000 so'm marja qoladi.",
        fail: "Xato. Formula: (Sotuv narxi - Tannarx) * Kunlik hajm * 30."
      },
      {
        id: 2, level: 'easy', levelTxt: "Boshlang'ich (Oddiy)", title: "Mijozni Jalb Qilish Xarajati (CAC)",
        sit: "Onlayn do'kon target reklamasiga oyiga $300 sarflab, 60 ta yangi mijoz oldi.",
        prompt: "Bitta yangi xaridorni jalb qilish xarajati (CAC) necha dollar?",
        inputs: [{ id: 'c_cac', label: "CAC ($):", val: 5, hint: "300 / 60" }],
        success: "To'g'ri! CAC = $5. Unit-iqtisodiyot juda sog'lom.",
        fail: "Xato. CAC = Marketing sarfi / Yangi mijozlar soni."
      },
      {
        id: 3, level: 'medium', levelTxt: "O'rta Daraja", title: "AgroTech: Zararsizlik Nuqtasi (BEP)",
        sit: "Issiqxonaning oylik doimiy xarajati 15,000,000 so'm. 1 kg pomidor narxi 20,000 so'm, yetishtirish 14,000 so'm.",
        prompt: "Zararsizlikka erishish uchun oyiga kamida necha kg pomidor sotilishi kerak?",
        inputs: [{ id: 'c_bep', label: "Minimal hajm (kg):", val: 2500, hint: "15,000,000 / (20,000 - 14,000)" }],
        success: "A'lo! 2,500 kg pomidor sotilsa korxona zararsiz ishlaydi.",
        fail: "Xato. BEP = Doimiy xarajat / (Narx - O'zgaruvchan tannarx)."
      },
      {
        id: 4, level: 'medium', levelTxt: "O'rta Daraja", title: "Kassa Uzilishi (Cash Gap) Kunlari",
        sit: "Tovar yetkazuvchidan 30 kunlik kechiktiruv bilan olindi, lekin omborda 45 kun turib keyin sotildi.",
        prompt: "Korxonada necha kunlik kassa uzilishi (Cash Gap) yuzaga keldi?",
        inputs: [{ id: 'c_gap', label: "Uzilish kunlari:", val: 15, hint: "45 - 30" }],
        success: "To'g'ri! 15 kunlik aylanma mablag' yetishmovchiligi yuzaga keladi.",
        fail: "Xato. Omborda turish muddati bilan to'lov muddati farqi: 45 - 30."
      },
      {
        id: 5, level: 'hard', levelTxt: "Murakkab (MBA)", title: "Valyuta Devalvatsiyasi va Forvard Xedjirlash",
        sit: "Korxona $100,000 import qiladi. Joriy kurs 12,800 so'm. 3 oydan so'ng 13,400 bo'lishi kutilmoqda. Bank bilan 12,950 so'mdan forvard ochildi.",
        prompt: "Forvard xedjirlash orqali qancha so'm yo'qotishdan saqlanib qolindi?",
        inputs: [{ id: 'c_fwd', label: "Tejalgan mablag' (so'm):", val: 45000000, hint: "(13,400 - 12,950) * 100,000" }],
        success: "Ajoyib! 45,000,000 so'm valyuta zarari to'liq bartaraf etildi.",
        fail: "Xato. (Kutilayotgan kurs - Forvard kursi) * Summa."
      },
      {
        id: 6, level: 'hard', levelTxt: "Murakkab (MBA)", title: "Venchur Investitsiya va Cap-Table Dilution",
        sit: "Startap Pre-Money qiymati $800,000. Investor $200,000 sarmoya kiritmoqda.",
        prompt: "Investitsiyadan keyin investorning ulushi necha foiz bo'ladi?",
        inputs: [{ id: 'c_dil', label: "Investor ulushi (%):", val: 20, hint: "200,000 / (800,000 + 200,000) * 100" }],
        success: "To'g'ri! Post-Money qiymati $1,000,000 va investor ulushi 20% bo'ladi.",
        fail: "Xato. Ulush = Investitsiya / (Pre-Money + Investitsiya) * 100%."
      }
    ];

    // MODULLAR UCHUN VIDEO VA QO'LLANMALAR
    const moduleResources = {
      battle: {
        title: "1-Modul: Bozor Jangi (Uzum vs Yandex)",
        video: "Kurno va Bertran dueli: Narx urushlari, xizmat sifati va bozor ulushini taqsimlash algoritmlari.",
        guide: "Metodik qo'llanma: Narx elastikligi, mijoz jalb qilish xarajati (CAC) va agressiv marketing byudjetini rejalashtirish bo'yicha amaliy yo'riqnoma."
      },
      lab: {
        title: "2-Modul: Milliy Keyslar (Uzum, Korzinka, BYD)",
        video: "O'zbekiston yirik korxonalarining ta'minot zanjiri va mahalliylashtirish strategiyalari tahlili.",
        guide: "Metodik qo'llanma: FMCG chakana savdosi, avtomobil sanoatida lokalizatsiya va SI oldida biznes-reja himoya qilish standarti."
      },
      forensic: {
        title: "3-Modul: Balans Auditi & Forensic",
        video: "Kassa uzilishini (Cash Gap) bartaraf etish, debitorlik qarzlarini undirish va xarajatlarni 20% qisqartirish amaliyoti.",
        guide: "Metodik qo'llanma: Inqirozli korxonalar balansi tahlili, zaxiralarni optimallashtirish va qarz yuklamasini restrukturizatsiya qilish yo'riqnomasi."
      },
      eoq: {
        title: "4-Modul: Ta'minot & EOQ Modeli",
        video: "Wilson formulasi: Optimal buyurtma partiyasi (EOQ), ombor saqlash xarajati va Safety Stock hisoblash.",
        guide: "Metodik qo'llanma: Yillik talab va yetkazib berish kunlari asosida qayta buyurtma nuqtasini (ROP) aniqlash ekonometrik modeli."
      },
      pricing: {
        title: "5-Modul: Dinamik Narx Belgilash",
        video: "Talab elastikligi (Ed) koeffitsiyenti va narx oshirilganda sof marjani maksimal darajaga chiqarish.",
        guide: "Metodik qo'llanma: Dinamik narx strategiyalari, chegirmalar ta'siri va marjinallikni saqlab qolish qoidalari."
      },
      security: {
        title: "6-Modul: Iqtisodiy Xavfsizlik Stress-Testi",
        video: "So'm devalvatsiyasi va tashqi bojxona xatarlariga qarshi korxona chidamlilik indeksini (Survival Score) shakllantirish.",
        guide: "Metodik qo'llanma: Valyuta risklarini xedjirlash, favqulodda zaxira fondi normativi va komplayens xavfsizligi."
      },
      board: {
        title: "7-Modul: Boshqaruv Kengashi (Board Pitch)",
        video: "Aksiyadorlar va Direktorlar Kengashiga yillik EBITDA hisoboti va 3 yillik kapitallashuv (Valuation) taqdimoti.",
        guide: "Metodik qo'llanma: C-Level (CFO, CMO, CRO) hisobotlarini yozish, 5.8x EBITDA multiplikatori va 1 varaqli memorandum standarti."
      }
    };

    function switchView(tab) {
      ['cases', 'battle', 'lab', 'forensic', 'eoq', 'pricing', 'security', 'board'].forEach(k => {
        document.getElementById(`view-${k}`).classList.add('hidden');
        document.getElementById(`tab-${k}`).className = 'px-3 py-1.5 rounded-lg font-bold text-slate-400 hover:text-white';
      });
      document.getElementById(`view-${tab}`).classList.remove('hidden');

      if (tab === 'cases') {
        document.getElementById('tab-cases').className = 'px-3 py-1.5 rounded-lg font-black bg-amber-500 text-slate-950 shadow';
        renderCaseList('all');
      } else {
        document.getElementById(`tab-${tab}`).className = 'px-3 py-1.5 rounded-lg font-bold bg-rose-600 text-white shadow';
      }

      if (tab === 'lab' && missions.length === 0) loadMissionsData();
      if (tab === 'forensic') runForensicAction();
      if (tab === 'eoq') runEOQAction();
      if (tab === 'pricing') runPricingAction();
      if (tab === 'security') runSecurityAction();
      if (tab === 'board') runBoardEvaluationAction();
    }

    // KEYS RENDER
    function renderCaseList(filter) {
      const container = document.getElementById('cases-grid-container');
      const list = filter === 'all' ? caseBank : caseBank.filter(x => x.level === filter);

      container.innerHTML = list.map(c => {
        const badgeColor = c.level === 'easy' ? 'bg-emerald-500/10 text-emerald-400 border-emerald-500/30' : (c.level === 'medium' ? 'bg-amber-500/10 text-amber-400 border-amber-500/30' : 'bg-rose-500/10 text-rose-400 border-rose-500/30');
        return `
          <div class="bg-slate-900 border border-slate-800 p-5 rounded-2xl flex flex-col justify-between space-y-4 hover:border-amber-500/50 transition">
            <div class="space-y-2">
              <span class="text-[10px] font-mono px-2 py-0.5 rounded-full border ${badgeColor} font-bold">${c.levelTxt}</span>
              <h4 class="text-sm font-bold text-white mt-1">${c.title}</h4>
              <p class="text-xs text-slate-400 leading-relaxed">${c.sit}</p>
            </div>
            <button onclick="openCaseSolveModal(${c.id})" class="w-full py-2.5 rounded-xl bg-amber-500/20 text-amber-300 hover:bg-amber-500 hover:text-slate-950 text-xs font-bold transition flex items-center justify-center gap-1.5">
              <span>Masalani Yechish & Tekshirish</span> <i class="fa-solid fa-arrow-right text-[11px]"></i>
            </button>
          </div>
        `;
      }).join('');
    }

    function filterCaseList(flt) {
      document.querySelectorAll('.case-flt-btn').forEach(b => {
        if (b.getAttribute('data-flt') === flt) {
          b.className = "case-flt-btn px-3 py-1.5 rounded-xl text-xs font-bold bg-amber-500 text-slate-950";
        } else {
          b.className = "case-flt-btn px-3 py-1.5 rounded-xl text-xs font-semibold bg-slate-900 text-slate-300 border border-slate-800 hover:text-white";
        }
      });
      renderCaseList(flt);
    }

    let activeCase = null;
    function openCaseSolveModal(id) {
      activeCase = caseBank.find(x => x.id === id);
      if (!activeCase) return;

      document.getElementById('cs-modal-lvl').innerText = activeCase.levelTxt.toUpperCase();
      document.getElementById('cs-modal-title').innerText = activeCase.title;
      document.getElementById('cs-modal-sit').innerText = activeCase.sit;
      document.getElementById('cs-modal-prompt').innerText = activeCase.prompt;

      const inpsBox = document.getElementById('cs-modal-inputs');
      inpsBox.innerHTML = activeCase.inputs.map(inp => `
        <div>
          <label class="text-[11px] text-slate-400 block mb-1">${inp.label}</label>
          <input type="number" id="${inp.id}" placeholder="${inp.hint}" class="w-full bg-slate-900 border border-slate-800 rounded-xl p-2.5 text-white font-mono text-xs">
        </div>
      `).join('');

      document.getElementById('cs-modal-res').classList.add('hidden');
      document.getElementById('case-solve-modal').classList.remove('hidden');
    }

    function checkCaseSolution() {
      if (!activeCase) return;
      let ok = true;
      activeCase.inputs.forEach(inp => {
        const val = parseFloat(document.getElementById(inp.id).value);
        if (val !== inp.val) ok = false;
      });

      const resBox = document.getElementById('cs-modal-res');
      const scoreTxt = document.getElementById('cs-modal-score');
      const fbTxt = document.getElementById('cs-modal-feedback');

      if (ok) {
        scoreTxt.innerText = "100 / 100 (To'g'ri!)";
        scoreTxt.className = "font-mono font-bold text-emerald-400";
        fbTxt.innerText = activeCase.success;
      } else {
        scoreTxt.innerText = "30 / 100 (Xato hisoblandi)";
        scoreTxt.className = "font-mono font-bold text-rose-400";
        fbTxt.innerText = activeCase.fail;
      }
      resBox.classList.remove('hidden');
    }

    function closeCaseSolveModal() {
      document.getElementById('case-solve-modal').classList.add('hidden');
    }

    // MODAL RESURS (VIDEO & GUIDE)
    function openResourceModal(modKey, type) {
      const res = moduleResources[modKey];
      if (!res) return;

      const titleEl = document.getElementById('res-modal-title');
      const bodyEl = document.getElementById('res-modal-body');

      if (type === 'video') {
        titleEl.innerHTML = `<i class="fa-solid fa-circle-play text-amber-400"></i> ${res.title} — Video Leksiya`;
        bodyEl.innerHTML = `
          <div class="aspect-video bg-black rounded-xl overflow-hidden border border-slate-800 flex items-center justify-center">
            <iframe class="w-full h-full" src="https://www.youtube.com/embed/dQw4w9WgXcQ" title="Video" frameborder="0" allowfullscreen></iframe>
          </div>
          <p class="text-slate-300">${res.video}</p>
        `;
      } else {
        titleEl.innerHTML = `<i class="fa-solid fa-file-pdf text-emerald-400"></i> ${res.title} — Metodik Qo'llanma`;
        bodyEl.innerHTML = `
          <div class="p-4 bg-slate-950 rounded-xl border border-slate-800 space-y-2">
            <h4 class="font-bold text-white text-xs">Akademik Metodik Konspekt:</h4>
            <p class="text-slate-300 leading-relaxed">${res.guide}</p>
          </div>
          <button onclick="window.print()" class="w-full py-2 bg-emerald-600 hover:bg-emerald-500 text-white font-bold rounded-xl text-xs">
            <i class="fa-solid fa-print mr-1"></i> Qo'llanmani Chop Etish (PDF)
          </button>
        `;
      }
      document.getElementById('resource-modal').classList.remove('hidden');
    }

    function closeResourceModal() {
      document.getElementById('resource-modal').classList.add('hidden');
    }

    // 1. BOZOR JANGI DUEL
    async function runDuelAction() {
      const payload = {
        round_number: duelRound,
        team_a: { name: "Uzum Express", price: parseInt(document.getElementById('c_a_p').value), marketing: parseInt(document.getElementById('c_a_m').value), quality: parseInt(document.getElementById('c_a_q').value) },
        team_b: { name: "Yandex / Express24", price: parseInt(document.getElementById('c_b_p').value), marketing: parseInt(document.getElementById('c_b_m').value), quality: parseInt(document.getElementById('c_b_q').value) }
      };

      const res = await fetch('/api/v1/battle/play-round', { method: 'POST', headers: {'Content-Type': 'application/json'}, body: JSON.stringify(payload) });
      const d = await res.json();

      window.lastMetrics.battle_profit = d.team_a.net_profit;

      document.getElementById('res-a-share').innerText = d.team_a.market_share + '%';
      document.getElementById('res-a-orders').innerText = d.team_a.orders.toLocaleString() + ' ta';
      document.getElementById('res-a-profit').innerText = (d.team_a.net_profit >= 0 ? '+' : '') + (d.team_a.net_profit / 1000000).toFixed(1) + ' mln so\'m';
      document.getElementById('res-a-profit').className = d.team_a.net_profit >= 0 ? 'text-emerald-400 font-bold' : 'text-red-400 font-bold';

      document.getElementById('res-b-share').innerText = d.team_b.market_share + '%';
      document.getElementById('res-b-orders').innerText = d.team_b.orders.toLocaleString() + ' ta';
      document.getElementById('res-b-profit').innerText = (d.team_b.net_profit >= 0 ? '+' : '') + (d.team_b.net_profit / 1000000).toFixed(1) + ' mln so\'m';
      document.getElementById('res-b-profit').className = d.team_b.net_profit >= 0 ? 'text-rose-400 font-bold' : 'text-red-400 font-bold';

      document.getElementById('duel-analysis-text').innerText = d.analysis;

      const badge = document.getElementById('duel-winner-badge');
      if (d.winner === 'team_a') { badge.className = 'text-xs font-bold px-3 py-1 rounded-full bg-emerald-950 border border-emerald-500 text-emerald-300'; badge.innerText = "Uzum Express yutdi!"; }
      else if (d.winner === 'team_b') { badge.className = 'text-xs font-bold px-3 py-1 rounded-full bg-rose-950 border border-rose-500 text-rose-300'; badge.innerText = "Yandex yutdi!"; }
      else { badge.className = 'text-xs font-bold px-3 py-1 rounded-full bg-slate-800 text-slate-300'; badge.innerText = "Durang!"; }

      treasuryA += d.team_a.net_profit;
      treasuryB += d.team_b.net_profit;
      document.getElementById('treasury-a').innerText = treasuryA.toLocaleString() + " so'm";
      document.getElementById('treasury-b').innerText = treasuryB.toLocaleString() + " so'm";

      updateDuelCharts(d.team_a, d.team_b);

      if (duelRound < 4) {
        duelRound++;
        document.getElementById('battle-round-lbl').innerText = `${duelRound}-Chorak (Raund ${duelRound}/4)`;
      } else {
        const win = treasuryA > treasuryB ? "1-Jamoa (Uzum)" : "2-Jamoa (Yandex)";
        alert(`Chempionat yakunlandi!\n\nG'olib: ${win}`);
      }
    }

    function updateDuelCharts(a, b) {
      const pCtx = document.getElementById('duelPieChart').getContext('2d');
      if (duelPieInst) duelPieInst.destroy();
      duelPieInst = new Chart(pCtx, {
        type: 'doughnut',
        data: { labels: ['Uzum Express', 'Yandex / Express24'], datasets: [{ data: [a.market_share, b.market_share], backgroundColor: ['#10b981', '#f43f5e'] }] },
        options: { responsive: true, maintainAspectRatio: false }
      });

      const bCtx = document.getElementById('duelBarChart').getContext('2d');
      if (duelBarInst) duelBarInst.destroy();
      duelBarInst = new Chart(bCtx, {
        type: 'bar',
        data: { labels: ['Uzum Express', 'Yandex / Express24'], datasets: [{ data: [a.net_profit, b.net_profit], backgroundColor: [a.net_profit>=0?'#10b981':'#ef4444', b.net_profit>=0?'#f43f5e':'#ef4444'], borderRadius: 6 }] },
        options: { responsive: true, maintainAspectRatio: false }
      });
    }

    // 2. MILLIY KEYSLAR
    async function loadMissionsData() {
      const res = await fetch('/api/v1/missions');
      missions = await res.json();
      const list = document.getElementById('missions-list');
      list.innerHTML = '';

      missions.forEach(m => {
        const item = document.createElement('div');
        item.className = `p-3 rounded-xl border cursor-pointer transition ${activeMission && activeMission.id === m.id ? 'bg-emerald-950/60 border-emerald-500' : 'bg-slate-950 hover:bg-slate-900 border-slate-800'}`;
        item.onclick = () => selectMission(m);
        item.innerHTML = `
          <div class="flex justify-between items-center mb-1">
            <span class="text-[10px] font-bold uppercase text-emerald-400">${m.company}</span>
            <span class="text-[10px] px-2 py-0.5 rounded bg-slate-900 text-slate-400">${m.badge}</span>
          </div>
          <h4 class="text-xs font-bold text-white">${m.title}</h4>
        `;
        list.appendChild(item);
      });

      if (missions.length > 0 && !activeMission) selectMission(missions[0]);
    }

    function selectMission(m) {
      activeMission = m;
      document.getElementById('active-title').innerText = m.title;
      document.getElementById('active-desc').innerText = m.theory_brief;
      document.getElementById('active-badge').innerText = m.badge;
      document.getElementById('theory-text').innerText = m.theory_brief;
      document.getElementById('video-frame').src = m.video_url;

      const sContainer = document.getElementById('shocks-container');
      sContainer.innerHTML = '';
      (m.shocks || []).forEach(s => {
        const btn = document.createElement('button');
        btn.id = `shock-btn-${s.id}`;
        btn.className = 'w-full text-left p-2.5 rounded-xl border border-slate-800 bg-slate-950 hover:border-amber-500/50 text-xs transition';
        btn.onclick = () => toggleShockAction(s);
        btn.innerHTML = `<div class="font-bold text-amber-300 text-[11px]">${s.title}</div><div class="text-[10px] text-slate-400 mt-0.5">${s.description}</div>`;
        sContainer.appendChild(btn);
      });

      const qContainer = document.getElementById('quiz-container');
      qContainer.innerHTML = '';
      m.quiz.forEach((q, idx) => {
        const qDiv = document.createElement('div');
        qDiv.className = 'p-3 bg-slate-950 rounded-xl border border-slate-800 text-xs space-y-2';
        qDiv.innerHTML = `<div class="font-bold text-white">${idx + 1}. ${q.question}</div>`;
        q.options.forEach((opt, oIdx) => {
          qDiv.innerHTML += `
            <label class="flex items-center space-x-2 text-slate-300 cursor-pointer">
              <input type="radio" name="${q.id}" value="${oIdx}" class="accent-indigo-500">
              <span>${opt}</span>
            </label>
          `;
        });
        qContainer.appendChild(qDiv);
      });

      renderClassicControls(m.type);
      chatHistory = [];
      labRound = 1;
      document.getElementById('round-idx-lbl').innerText = "1 / 3";
      document.getElementById('certificate-card').classList.add('hidden');
      gotoLabStep(1);
    }

    function renderClassicControls(type) {
      const c = document.getElementById('lab-dynamic-controls');
      c.innerHTML = '';
      if (type === 'logistics') {
        c.innerHTML = `
          <div><div class="flex justify-between font-semibold mb-1"><span>Hublar soni:</span><span id="vc1" class="text-emerald-400 font-bold">2 ta</span></div><input type="range" id="c_hubs" min="1" max="5" value="2" oninput="document.getElementById('vc1').innerText=this.value+' ta'; runClassicSim()" class="w-full accent-emerald-500"></div>
          <div><label class="block font-semibold mb-1">Kuryerlar modeli:</label><select id="c_courier" onchange="runClassicSim()" class="w-full p-2 bg-slate-900 border border-slate-800 rounded-lg text-xs text-white"><option value="ichki_shtat">O'z kuryerlari</option><option value="autsorsing">Tashqi autsorsing</option></select></div>
          <div><div class="flex justify-between font-semibold mb-1"><span>Marketing byudjeti:</span><span id="vc2" class="text-emerald-400 font-bold">15,000,000 so'm</span></div><input type="range" id="c_mkt" min="5000000" max="40000000" step="2500000" value="15000000" oninput="document.getElementById('vc2').innerText=parseInt(this.value).toLocaleString()+' so\'m'; runClassicSim()" class="w-full accent-emerald-500"></div>
        `;
      } else if (type === 'retail') {
        c.innerHTML = `
          <div><div class="flex justify-between font-semibold mb-1"><span>Chakana narx ustamasi:</span><span id="vc1" class="text-emerald-400 font-bold">22%</span></div><input type="range" id="c_markup" min="10" max="40" value="22" oninput="document.getElementById('vc1').innerText=this.value+'%'; runClassicSim()" class="w-full accent-emerald-500"></div>
          <div><div class="flex justify-between font-semibold mb-1"><span>Chegirma:</span><span id="vc2" class="text-emerald-400 font-bold">5%</span></div><input type="range" id="c_discount" min="0" max="25" value="5" oninput="document.getElementById('vc2').innerText=this.value+'%'; runClassicSim()" class="w-full accent-emerald-500"></div>
          <div><div class="flex justify-between font-semibold mb-1"><span>Do'konlar soni:</span><span id="vc3" class="text-emerald-400 font-bold">25 ta</span></div><input type="range" id="c_stores" min="10" max="60" value="25" oninput="document.getElementById('vc3').innerText=this.value+' ta'; runClassicSim()" class="w-full accent-emerald-500"></div>
        `;
      } else if (type === 'automotive') {
        c.innerHTML = `
          <div><div class="flex justify-between font-semibold mb-1"><span>Oylik ishlab chiqarish:</span><span id="vc1" class="text-emerald-400 font-bold">1,200 dona</span></div><input type="range" id="c_vol" min="400" max="3000" step="100" value="1200" oninput="document.getElementById('vc1').innerText=parseInt(this.value).toLocaleString()+' dona'; runClassicSim()" class="w-full accent-emerald-500"></div>
          <div><div class="flex justify-between font-semibold mb-1"><span>Eksport ulushi:</span><span id="vc2" class="text-emerald-400 font-bold">30%</span></div><input type="range" id="c_exp" min="10" max="70" value="30" oninput="document.getElementById('vc2').innerText=this.value+'%'; runClassicSim()" class="w-full accent-emerald-500"></div>
          <div><div class="flex justify-between font-semibold mb-1"><span>Lokalizatsiya:</span><span id="vc3" class="text-emerald-400 font-bold">45%</span></div><input type="range" id="c_loc" min="20" max="75" value="45" oninput="document.getElementById('vc3').innerText=this.value+'%'; runClassicSim()" class="w-full accent-emerald-500"></div>
        `;
      } else {
        c.innerHTML = `
          <div><div class="flex justify-between font-semibold mb-1"><span>Boshlang'ich Capex:</span><span id="vc1" class="text-emerald-400 font-bold">50 mlrd so'm</span></div><input type="range" id="c_capex" min="20" max="100" step="5" value="50" oninput="document.getElementById('vc1').innerText=this.value+' mlrd so\'m'; runClassicSim()" class="w-full accent-emerald-500"></div>
          <div><div class="flex justify-between font-semibold mb-1"><span>Diskont stavkasi WACC:</span><span id="vc2" class="text-emerald-400 font-bold">16%</span></div><input type="range" id="c_wacc" min="10" max="26" value="16" oninput="document.getElementById('vc2').innerText=this.value+'%'; runClassicSim()" class="w-full accent-emerald-500"></div>
          <div><div class="flex justify-between font-semibold mb-1"><span>Pul oqimi o'sishi:</span><span id="vc3" class="text-emerald-400 font-bold">15%</span></div><input type="range" id="c_growth" min="5" max="30" value="15" oninput="document.getElementById('vc3').innerText=this.value+'%'; runClassicSim()" class="w-full accent-emerald-500"></div>
        `;
      }
    }

    function toggleShockAction(shock) {
      const alertBox = document.getElementById('lab-shock-alert');
      if (activeShock === shock.id) {
        activeShock = null;
        document.querySelectorAll('#shocks-container button').forEach(b => b.className = 'w-full text-left p-2.5 rounded-xl border border-slate-800 bg-slate-950 text-xs transition');
        alertBox.classList.add('hidden');
      } else {
        activeShock = shock.id;
        document.querySelectorAll('#shocks-container button').forEach(b => b.className = 'w-full text-left p-2.5 rounded-xl border border-slate-800 bg-slate-950 text-xs transition');
        document.getElementById(`shock-btn-${shock.id}`).className = 'w-full text-left p-2.5 rounded-xl border border-red-500 bg-red-950/60 text-xs transition shadow-lg';
        alertBox.classList.remove('hidden');
        gotoLabStep(3);
      }
      runClassicSim();
    }

    function gotoLabStep(num) {
      for (let i = 1; i <= 4; i++) {
        document.getElementById(`lab-step-${i}`).classList.add('hidden');
        document.getElementById(`lab-step-btn-${i}`).className = 'py-2.5 rounded-xl border border-slate-800 bg-slate-950 text-slate-400 flex flex-col items-center';
      }
      document.getElementById(`lab-step-${num}`).classList.remove('hidden');
      document.getElementById(`lab-step-btn-${num}`).className = 'py-2.5 rounded-xl border border-emerald-500 bg-emerald-500/10 text-emerald-400 flex flex-col items-center';
      if (num === 3) runClassicSim();
    }

    async function submitQuizAction() {
      const answers = {};
      activeMission.quiz.forEach(q => {
        const chk = document.querySelector(`input[name="${q.id}"]:checked`);
        if (chk) answers[q.id] = parseInt(chk.value);
      });

      const res = await fetch('/api/v1/missions/quiz-check', { method: 'POST', headers: {'Content-Type': 'application/json'}, body: JSON.stringify({ mission_id: activeMission.id, answers: answers }) });
      const data = await res.json();
      const div = document.getElementById('quiz-result-box');
      div.classList.remove('hidden');
      if (data.passed) {
        div.className = 'p-3 rounded-xl text-xs bg-emerald-950 border border-emerald-500 text-emerald-300';
        div.innerHTML = `<strong>Natija: ${data.score_percent}%</strong> — ${data.message} <button onclick="gotoLabStep(3)" class="ml-2 font-bold underline">Simulyatorga o'tish →</button>`;
      } else {
        div.className = 'p-3 rounded-xl text-xs bg-red-950 border border-red-500 text-red-300';
        div.innerHTML = `<strong>Natija: ${data.score_percent}%</strong> — ${data.message}`;
      }
    }

    async function runClassicSim() {
      const currentType = (activeMission && activeMission.type) ? activeMission.type : 'logistics';
      const currentMissionId = (activeMission && activeMission.id) ? activeMission.id : 1;
      let payload = { mission_id: currentMissionId, active_shock: activeShock };

      if (currentType === 'logistics') {
        payload.hub_count = parseInt(document.getElementById('c_hubs')?.value || 2);
        payload.courier_model = document.getElementById('c_courier')?.value || 'ichki_shtat';
        payload.marketing_budget = parseFloat(document.getElementById('c_mkt')?.value || 15000000);
      } else if (currentType === 'retail') {
        payload.retail_markup = parseInt(document.getElementById('c_markup')?.value || 22);
        payload.retail_discount = parseInt(document.getElementById('c_discount')?.value || 5);
        payload.store_count = parseInt(document.getElementById('c_stores')?.value || 25);
      } else if (currentType === 'automotive') {
        payload.production_volume = parseInt(document.getElementById('c_vol')?.value || 1200);
        payload.export_share = parseInt(document.getElementById('c_exp')?.value || 30);
        payload.localization_rate = parseInt(document.getElementById('c_loc')?.value || 45);
      } else {
        payload.capex_investment = parseFloat(document.getElementById('c_capex')?.value || 50) * 1000000000;
        payload.wacc_rate = parseFloat(document.getElementById('c_wacc')?.value || 16);
        payload.operating_cash_flow_growth = parseInt(document.getElementById('c_growth')?.value || 15);
      }

      const res = await fetch('/api/v1/missions/simulate-advanced', { method: 'POST', headers: {'Content-Type': 'application/json'}, body: JSON.stringify(payload) });
      const d = await res.json();
      window.lastSimResult = d;

      const kpiBox = document.getElementById('lab-dynamic-kpis');
      kpiBox.innerHTML = '';
      (d.kpis || []).forEach(k => {
        kpiBox.innerHTML += `<div><div class="text-[10px] text-slate-400">${k.label}</div><div class="font-bold text-${k.color}-400 text-xs mt-0.5">${k.val}</div></div>`;
      });

      const bCtx = document.getElementById('classicBarChart').getContext('2d');
      if (classicBarInst) classicBarInst.destroy();
      classicBarInst = new Chart(bCtx, {
        type: 'bar',
        data: { labels: d.chart_bar.labels, datasets: [{ data: d.chart_bar.data, backgroundColor: ['#3b82f6', '#ef4444', '#10b981'], borderRadius: 6 }] },
        options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { display: false } } }
      });

      const pCtx = document.getElementById('classicPieChart').getContext('2d');
      if (classicPieInst) classicPieInst.destroy();
      classicPieInst = new Chart(pCtx, {
        type: 'doughnut',
        data: { labels: d.chart_pie.labels, datasets: [{ data: d.chart_pie.data, backgroundColor: ['#10b981', '#334155'] }] },
        options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { display: false } } }
      });
    }

    // SI CHATI
    async function sendChatMsg() {
      const input = document.getElementById('chat-input');
      const text = input.value.trim();
      if (!text) return;

      const currentMissionId = (activeMission && activeMission.id) ? activeMission.id : 1;
      const currentMissionTitle = (activeMission && activeMission.title) ? activeMission.title : "Uzum Market Logistika";

      const cBox = document.getElementById('chat-box');
      cBox.innerHTML += `
        <div class="flex items-start justify-end space-x-2">
          <div class="bg-emerald-600 p-2.5 rounded-xl text-white max-w-[85%] shadow">${text}</div>
        </div>
      `;
      chatHistory.push({ role: 'user', content: text });
      input.value = '';
      cBox.scrollTop = cBox.scrollHeight;

      const btn = document.getElementById('chat-send-btn');
      btn.disabled = true;

      try {
        const res = await fetch('/api/v1/missions/ai-debate', {
          method: 'POST',
          headers: {'Content-Type': 'application/json'},
          body: JSON.stringify({
            mission_id: currentMissionId,
            history: chatHistory,
            decision_summary: `${currentMissionTitle} (KPIlar: ${window.lastSimResult ? JSON.stringify(window.lastSimResult.kpis) : 'Oddiy rejim'})`,
            round_index: labRound
          })
        });

        const data = await res.json();
        chatHistory.push({ role: 'assistant', content: data.reply });

        cBox.innerHTML += `
          <div class="flex items-start space-x-2">
            <div class="bg-purple-900/60 p-1.5 rounded-lg text-purple-300"><i class="fa-solid fa-user-tie"></i></div>
            <div class="bg-slate-900 border border-slate-800 p-2.5 rounded-xl text-slate-200 max-w-[85%] shadow">
              <strong>SI Professor:</strong> ${data.reply}
            </div>
          </div>
        `;
        cBox.scrollTop = cBox.scrollHeight;

        if (data.round_complete && data.next_round) {
          labRound = data.next_round;
          document.getElementById('round-idx-lbl').innerText = `${labRound} / 3`;
        }

        if (data.is_ready_for_certificate && data.certificate_data) {
          const cert = data.certificate_data;
          document.getElementById('cert-mission-name').innerText = currentMissionTitle;
          document.getElementById('cert-score-lbl').innerText = `${cert.score} / 100 (${cert.verdict})`;
          document.getElementById('cert-date-lbl').innerText = cert.date;
          document.getElementById('cert-id-lbl').innerText = cert.cert_id;
          document.getElementById('cert-qr-img').src = cert.qr_url;
          document.getElementById('certificate-card').classList.remove('hidden');
          document.getElementById('certificate-card').scrollIntoView({ behavior: 'smooth' });
        }
      } catch (err) {
        console.error("Chat xatosi:", err);
      } finally {
        btn.disabled = false;
      }
    }

    // 3. FORENSIC AUDIT
    async function runForensicAction() {
      const payload = {
        cut_admin_expenses_pct: parseInt(document.getElementById('c_fa_admin').value),
        restructure_debt_months: parseInt(document.getElementById('c_fa_debt').value),
        layoff_redundant_staff_pct: parseInt(document.getElementById('c_fa_staff').value),
        discount_slow_inventory_pct: parseInt(document.getElementById('c_fa_inv').value)
      };
      const res = await fetch('/api/v1/lab/forensic-audit', { method: 'POST', headers: {'Content-Type': 'application/json'}, body: JSON.stringify(payload) });
      const d = await res.json();
      window.lastMetrics.forensic_cash_flow = d.final_cash_flow;

      document.getElementById('fa_saved').innerText = (d.monthly_burn_rate_saved / 1000000).toFixed(1) + " mln so'm";
      document.getElementById('fa_cf').innerText = (d.final_cash_flow / 1000000).toFixed(1) + " mln so'm";
      document.getElementById('fa_cf').className = d.final_cash_flow > 0 ? "text-emerald-400 font-bold" : "text-red-400 font-bold";
      const v = document.getElementById('fa_verdict');
      v.innerText = d.verdict;
      v.className = d.is_recovered ? "p-3 rounded-lg bg-emerald-950 text-emerald-300 border border-emerald-600 font-bold" : "p-3 rounded-lg bg-red-950 text-red-300 border border-red-600 font-bold";
    }

    // 4. EOQ
    async function runEOQAction() {
      const demand = parseInt(document.getElementById('c_eoq_d').value) || 24000;
      const orderCost = parseFloat(document.getElementById('c_eoq_s').value) || 250000;
      const holdCost = parseFloat(document.getElementById('c_eoq_h').value) || 12000;
      const leadTime = parseInt(document.getElementById('c_eoq_l').value) || 5;

      const payload = {
        annual_demand: demand,
        order_cost: orderCost,
        holding_cost_unit: holdCost,
        lead_time_days: leadTime,
        safety_factor_z: 1.65
      };

      try {
        const res = await fetch('/api/v1/lab/supply-chain-eoq', {
          method: 'POST',
          headers: {'Content-Type': 'application/json'},
          body: JSON.stringify(payload)
        });
        const d = await res.json();
        window.lastMetrics.eoq_annual_cost = d.total_annual_inventory_cost;

        document.getElementById('eoq_val').innerText = d.eoq_units.toLocaleString() + " dona";
        document.getElementById('eoq_orders').innerText = d.orders_per_year + " marta";
        document.getElementById('eoq_safety').innerText = d.safety_stock_units.toLocaleString() + " dona";
        document.getElementById('eoq_rop').innerText = d.reorder_point_units.toLocaleString() + " dona";
        document.getElementById('eoq_cost').innerText = (d.total_annual_inventory_cost / 1000000).toFixed(1) + " mln so'm";

        const halfHoldingCost = (d.eoq_units / 2.0) * holdCost;
        const totalOrderingCost = d.orders_per_year * orderCost;
        
        const ctx = document.getElementById('eoqChart').getContext('2d');
        if (eoqChartInst) eoqChartInst.destroy();
        eoqChartInst = new Chart(ctx, {
          type: 'doughnut',
          data: {
            labels: ['Yillik Buyurtma Xarajati', 'Yillik Saqlash Xarajati'],
            datasets: [{
              data: [Math.round(totalOrderingCost), Math.round(halfHoldingCost)],
              backgroundColor: ['#6366f1', '#10b981'],
              borderWidth: 0
            }]
          },
          options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: { legend: { display: false } },
            cutout: '68%'
          }
        });
      } catch (err) {}
    }

    // 5. PRICING
    async function runPricingAction() {
      const payload = {
        base_price: 50000.0,
        price_change_pct: parseInt(document.getElementById('c_pr_change').value),
        elasticity_coefficient: parseFloat(document.getElementById('c_pr_ed').value) || -1.6,
        unit_cost: 32000.0
      };
      const res = await fetch('/api/v1/lab/dynamic-pricing', { method: 'POST', headers: {'Content-Type': 'application/json'}, body: JSON.stringify(payload) });
      const d = await res.json();
      window.lastMetrics.pricing_profit_delta = d.profit_delta;

      document.getElementById('pr_price').innerText = d.new_price.toLocaleString() + " so'm";
      document.getElementById('pr_vol').innerText = d.new_volume.toLocaleString() + " dona (" + d.volume_change_pct + "%)";
      document.getElementById('pr_profit').innerText = (d.profit_delta >= 0 ? '+' : '') + (d.profit_delta / 1000000).toFixed(1) + " mln so'm";
      document.getElementById('pr_profit').className = d.profit_delta >= 0 ? "text-emerald-400 font-bold" : "text-red-400 font-bold";
    }

    // 6. SECURITY
    async function runSecurityAction() {
      const payload = {
        fx_devaluation_pct: parseInt(document.getElementById('c_sec_fx').value),
        customs_tariff_pct: parseInt(document.getElementById('c_sec_tax').value),
        compliance_reserve_fund: parseFloat(document.getElementById('c_sec_fund').value) || 50000000
      };
      const res = await fetch('/api/v1/lab/security-stress-test', { method: 'POST', headers: {'Content-Type': 'application/json'}, body: JSON.stringify(payload) });
      const d = await res.json();
      window.lastMetrics.survival_score = d.survival_score;

      document.getElementById('sec_risk').innerText = (d.total_risk_exposure / 1000000).toFixed(1) + " mln so'm";
      document.getElementById('sec_score').innerText = d.survival_score + " / 100";
      const s = document.getElementById('sec_status');
      s.innerText = `Holat: ${d.risk_status} (Qoplash: ${d.coverage_ratio}%)`;
      s.className = d.survival_score >= 70 ? "p-3 rounded-lg bg-emerald-950 text-emerald-300 font-bold" : (d.survival_score >= 40 ? "p-3 rounded-lg bg-amber-950 text-amber-300 font-bold" : "p-3 rounded-lg bg-red-950 text-red-300 font-bold");
    }

    // ================= 7. BOSHQARUV KENGASHI EVALUATION =================
    async function runBoardEvaluationAction() {
      const payload = {
        battle_profit: window.lastMetrics.battle_profit,
        forensic_cash_flow: window.lastMetrics.forensic_cash_flow,
        eoq_annual_cost: window.lastMetrics.eoq_annual_cost,
        pricing_profit_delta: window.lastMetrics.pricing_profit_delta,
        survival_score: window.lastMetrics.survival_score,
        student_name: "Mirzarakhim B."
      };

      const res = await fetch('/api/v1/board/evaluate-pitch', {
        method: 'POST',
        headers: {'Content-Type': 'application/json'},
        body: JSON.stringify(payload)
      });
      const d = await res.json();

      document.getElementById('board-ebitda').innerText = (d.annual_ebitda / 1000000).toFixed(1) + " mln so'm";
      document.getElementById('board-valuation').innerText = (d.company_valuation / 1000000).toFixed(1) + " mln so'm";
      document.getElementById('board-score').innerText = d.board_score + " / 100";
      document.getElementById('board-verdict').innerText = d.board_decision;

      document.getElementById('print-ebitda').innerText = (d.annual_ebitda / 1000000).toFixed(1) + " mln so'm";
      document.getElementById('print-valuation').innerText = (d.company_valuation / 1000000).toFixed(1) + " mln so'm";
      document.getElementById('print-score').innerText = d.board_score + " / 100 (" + d.board_decision + ")";

      const c = document.getElementById('board-reviews-container');
      const pC = document.getElementById('print-reviews-box');
      c.innerHTML = '';
      pC.innerHTML = '';

      d.reviews.forEach(r => {
        c.innerHTML += `
          <div class="bg-slate-950 p-3.5 rounded-xl border border-slate-800 space-y-1 text-xs">
            <div class="flex justify-between items-center">
              <div><strong class="text-white">${r.role}</strong> <span class="text-slate-500">(${r.name})</span></div>
              <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-${r.color}-950 text-${r.color}-400 border border-${r.color}-800">${r.status}</span>
            </div>
            <p class="text-slate-300 text-[11px] leading-relaxed">${r.comment}</p>
          </div>
        `;
        pC.innerHTML += `<div><strong>${r.role}:</strong> ${r.status} — ${r.comment}</div>`;
      });

      const ctx = document.getElementById('boardValuationChart').getContext('2d');
      if (boardChartInst) boardChartInst.destroy();
      boardChartInst = new Chart(ctx, {
        type: 'line',
        data: {
          labels: ['1-Yil', '2-Yil (Prognoz)', '3-Yil (Prognoz)'],
          datasets: [{
            label: 'Korxona Qiymati (so\'m)',
            data: d.valuation_forecast,
            borderColor: '#f59e0b',
            backgroundColor: 'rgba(245, 158, 11, 0.1)',
            fill: true,
            tension: 0.35,
            borderWidth: 2,
            pointBackgroundColor: '#f59e0b',
            pointRadius: 4
          }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: { legend: { display: false } },
          scales: {
            y: { ticks: { color: '#94a3b8' }, grid: { color: '#1e293b' } },
            x: { ticks: { color: '#94a3b8' }, grid: { display: false } }
          }
        }
      });
    }

    window.onload = () => {
      renderCaseList('all');
      updateDuelCharts({ market_share: 50, net_profit: 25000000 }, { market_share: 50, net_profit: 25000000 });
    };
  </script>
</body>
</html>
